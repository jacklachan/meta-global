# Copy to .env and fill in. Never commit the real file.

# Meta Model API key: https://dev.meta.ai
MODEL_API_KEY=

# Optional overrides. Defaults are in copilot/config.py (muse-spark-1.3 for every role).
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# COPILOT_MODEL_TRIAGE=muse-spark-1.3
# COPILOT_MODEL_REASON=muse-spark-1.3
# COPILOT_MODEL_WRITER=muse-spark-1.3
# -contributor is ~12x cheaper but Meta uses the traffic to improve its products.
# Fine for the synthetic benchmark; do not use it on real incident data.
# COPILOT_MODEL_TRIAGE=muse-spark-1.3-contributor

# Optional: send one role to another OpenAI-compatible server, e.g. a
# fine-tuned Muse Glimmer served with vLLM on Modal.
# COPILOT_BASE_URL_TRIAGE=https://<you>--hindsight-triage.modal.run/v1
# COPILOT_API_KEY_TRIAGE=
# COPILOT_MODEL_TRIAGE=<served model name>

# Optional: enables the external-research step. https://tavily.com
TAVILY_API_KEY=
